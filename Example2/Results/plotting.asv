
%this code reproduce figures for time-varying regression model in Section 6.2 and Section S8 of the online supplement. 
% To run this need to add functions folder to the path.
addpath('.\functions');









%% Figure S7 of the online supplement
%sim = 4, Agric = 5, Food = 5.
figure
for i=1:20
    load(['mixCop_Global',num2str(i),'_200_statespace_Z_regression_FF.mat']);
    mean_collect(i,1) = mean(measure_latent);
end
subplot(1,3,1);plot(mean_collect,'LineWidth',3);xlabel({'number of components'},'FontSize',20);ylabel({'s[K]'},'FontSize',20);set(gca,'FontSize',20);title('Sim','FontSize',20);
set(gca,'FontSize',20)

for i=1:20
    load(['mixCop_Global',num2str(i),'_571_statespace_Z_regression_FF_RealData_Agric.mat']);
    mean_collect(i,1) = mean(measure_latent);
end
subplot(1,3,2);plot(mean_collect,'LineWidth',3);xlabel({'number of components'},'FontSize',20);ylabel({'s[K]'},'FontSize',20);set(gca,'FontSize',20);title('Agric','FontSize',20);
set(gca,'FontSize',20)

for i=1:20
    load(['mixCop_Global',num2str(i),'_571_statespace_Z_regression_FF_RealData_Food.mat']);
    mean_collect(i,1) = mean(measure_latent);
end
subplot(1,3,3);plot(mean_collect,'LineWidth',3);xlabel({'number of components'},'FontSize',20);ylabel({'s[K]'},'FontSize',20);set(gca,'FontSize',20);title('Food','FontSize',20);
set(gca,'FontSize',20)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Figure 7 of the main paper.
load('Zdata.mat');
nrSamples=100000;
num_points_ks=1000;
load('HMC_Z_StateSpace.mat');
i=4;
load(['mixCop_Global',num2str(i),'_200_statespace_Z_regression_FF.mat']);
for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_MixN = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);

i=1;
load(['mixCop_Global',num2str(i),'_200_statespace_Z_regression_FF.mat']);
for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_Precs = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);

load('wd_polypharm__tcop_StateSpace_Z_sim.mat');
[theta_tcop]= VArand_tcop(nrSamples,eta,mu,tkappa,l,log_nu,'');

load('wd_polypharm_YJ_tcop_StateSpace_Z_sim.mat');
[theta_tcop_YJ]= VArand_tcop(nrSamples,eta,mu,tkappa,l,log_nu,'YJ');

load('wd_polypharm_YJdouble_tcop_StateSpace_Z_sim.mat');
[theta_tcop_doubleYJ] = VArand_tcop(nrSamples,eta,mu,tkappa,l,log_nu,'YJdouble');


dim_states = 4;
num_states = 200;
id1 = (1:dim_states:dim_states*num_states)';
id2 = (2:dim_states:dim_states*num_states)';
id3 = (3:dim_states:dim_states*num_states)';
id4 = (4:dim_states:dim_states*num_states)';

mean_MCMC = mean(Post.theta,1);
low_quan_MCMC = quantile(Post.theta,0.025);
upper_quan_MCMC = quantile(Post.theta,0.975);

mean_MixN = mean(theta_cop1_MixN,2);
low_quan_MixN = quantile(theta_cop1_MixN,0.025,2);
upper_quan_MixN = quantile(theta_cop1_MixN,0.975,2);

mean_N = mean(theta_cop1_Precs,2);
low_quan_N = quantile(theta_cop1_Precs,0.025,2);
upper_quan_N = quantile(theta_cop1_Precs,0.975,2);

mean_tcop_YJ = mean(theta_tcop_YJ,2);
low_quan_tcop_YJ = quantile(theta_tcop_YJ,0.025,2);
upper_quan_tcop_YJ = quantile(theta_tcop_YJ,0.975,2);


mean_tcop_dYJ = mean(theta_tcop_doubleYJ,2);
low_quan_tcop_dYJ = quantile(theta_tcop_doubleYJ,0.025,2);
upper_quan_tcop_dYJ = quantile(theta_tcop_doubleYJ,0.975,2);

% --- MCMC (red) ---
subplot(2,2,1);
h1 = plot(mean_MCMC(id1),'LineWidth',2,'Color','r');   % store handle
hold on
plot(low_quan_MCMC(id1),'LineWidth',2,'Color','r');
plot(upper_quan_MCMC(id1),'LineWidth',2,'Color','r');

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id1),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id1),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id1),'LineWidth',2,'Color','g');

h3 = plot(beta1,'LineWidth',2,'Color','b');

xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_0','FontSize',20);

subplot(2,2,2);
h1 = plot(mean_MCMC(id2),'LineWidth',2,'Color','r');   % store handle
hold on
plot(low_quan_MCMC(id2),'LineWidth',2,'Color','r');
plot(upper_quan_MCMC(id2),'LineWidth',2,'Color','r');

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id2),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id2),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id2),'LineWidth',2,'Color','g');

h3 = plot(beta2,'LineWidth',2,'Color','b');

xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_1','FontSize',20);


subplot(2,2,3);
h1 = plot(mean_MCMC(id3),'LineWidth',2,'Color','r');   % store handle
hold on
plot(low_quan_MCMC(id3),'LineWidth',2,'Color','r');
plot(upper_quan_MCMC(id3),'LineWidth',2,'Color','r');

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id3),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id3),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id3),'LineWidth',2,'Color','g');

h3 = plot(beta3,'LineWidth',2,'Color','b');

xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_2','FontSize',20);

subplot(2,2,4);
h1 = plot(mean_MCMC(id4),'LineWidth',2,'Color','r');   % store handle
hold on
plot(low_quan_MCMC(id4),'LineWidth',2,'Color','r');
plot(upper_quan_MCMC(id4),'LineWidth',2,'Color','r');

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id4),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id4),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id4),'LineWidth',2,'Color','g');

h3 = plot(beta4,'LineWidth',2,'Color','b');

xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_3','FontSize',20);
legend([h1 h2 h3], {'HMC','MixGau','true'}, 'Location','best','FontSize',20);

