%% Figure 9 of the main paper
%marginal and bivariate density

nrSamples=100000;
num_points_ks=1000;
load('HMC_Z_StateSpace_Food.mat');
i=5;
load(['mixCop_Global',num2str(i),'_571_statespace_Z_regression_FF_RealData_Food.mat']);
for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_MixN = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);

i=5;
load(['mixCop_Global',num2str(i),'_571_statespace_Z_regression_FF_MF_RealData_Food.mat']);
for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_MixMF = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);


dim_states = 4;
num_states = 571;
id1 = (1:dim_states:dim_states*num_states)';
id2 = (2:dim_states:dim_states*num_states)';
id3 = (3:dim_states:dim_states*num_states)';
id4 = (4:dim_states:dim_states*num_states)';

theta_HMC_beta0 = Post.theta(:,id1);
theta_HMC_beta1 = Post.theta(:,id2);
theta_HMC_beta2 = Post.theta(:,id3);
theta_HMC_beta3 = Post.theta(:,id4);

theta_cop1_MixMF_beta0 = theta_cop1_MixMF(id1,:);
theta_cop1_MixMF_beta1 = theta_cop1_MixMF(id2,:);
theta_cop1_MixMF_beta2 = theta_cop1_MixMF(id3,:);
theta_cop1_MixMF_beta3 = theta_cop1_MixMF(id4,:);


theta_cop1_MixN_beta0 = theta_cop1_MixN(id1,:);
theta_cop1_MixN_beta1 = theta_cop1_MixN(id2,:);
theta_cop1_MixN_beta2 = theta_cop1_MixN(id3,:);
theta_cop1_MixN_beta3 = theta_cop1_MixN(id4,:);


num_points_ks = 1000;
subplot(1,2,1);
scatter(theta_cop1_MixN_beta1(50,:)',theta_cop1_MixN_beta1(51,:)')
hold on
scatter(theta_cop1_MixMF_beta1(50,:)',theta_cop1_MixMF_beta1(51,:)')
scatter(theta_HMC_beta1(:,50),theta_HMC_beta1(:,51))
xlabel('\beta_{1,50}','FontSize',20);
