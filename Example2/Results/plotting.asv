h1 = plot(beta2,'LineWidth',2,'Color','r');   % store handle
hold on

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id2),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id2),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id2),'LineWidth',2,'Color','g');

h3 = plot(mean_tcop_YJ(id2),'LineWidth',2,'Color','b');    % store handle
plot(low_quan_tcop_YJ(id2),'LineWidth',2,'Color','b');
plot(upper_quan_tcop_YJ(id2),'LineWidth',2,'Color','b');

h4 = plot(mean_tcop_dYJ(id2),'LineWidth',2,'Color','y');    % store handle
plot(low_quan_tcop_dYJ(id2),'LineWidth',2,'Color','y');
plot(upper_quan_tcop_dYJ(id2),'LineWidth',2,'Color','y');


xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_1','FontSize',20);


subplot(2,2,3);
h1 = plot(beta3,'LineWidth',2,'Color','r');   % store handle
hold on

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id3),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id3),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id3),'LineWidth',2,'Color','g');

h3 = plot(mean_tcop_YJ(id3),'LineWidth',2,'Color','b');    % store handle
plot(low_quan_tcop_YJ(id3),'LineWidth',2,'Color','b');
plot(upper_quan_tcop_YJ(id3),'LineWidth',2,'Color','b');

h4 = plot(mean_tcop_dYJ(id3),'LineWidth',2,'Color','y');    % store handle
plot(low_quan_tcop_dYJ(id3),'LineWidth',2,'Color','y');
plot(upper_quan_tcop_dYJ(id3),'LineWidth',2,'Color','y');


xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_2','FontSize',20);

subplot(2,2,4);
h1 = plot(beta4,'LineWidth',2,'Color','r');   % store handle
hold on

% --- Global / MixN (green) ---
h2 = plot(mean_MixN(id4),'LineWidth',2,'Color','g');    % store handle
plot(low_quan_MixN(id4),'LineWidth',2,'Color','g');
plot(upper_quan_MixN(id4),'LineWidth',2,'Color','g');

h3 = plot(mean_tcop_YJ(id4),'LineWidth',2,'Color','b');    % store handle
plot(low_quan_tcop_YJ(id4),'LineWidth',2,'Color','b');
plot(upper_quan_tcop_YJ(id4),'LineWidth',2,'Color','b');

h4 = plot(mean_tcop_dYJ(id4),'LineWidth',2,'Color','y');    % store handle
plot(low_quan_tcop_dYJ(id4),'LineWidth',2,'Color','y');
plot(upper_quan_tcop_dYJ(id4),'LineWidth',2,'Color','y');

xlabel('Time','FontSize',20);
set(gca,'FontSize',20);
title('\beta_3','FontSize',20);
legend([h1 h2 h3 h4], {'true','MixGau','YJ-tcop','D-YJ-tcop'}, 'Location','best','FontSize',20);

