h3 = plot(mean_MixMF(id1),'LineWidth',2,'Color','b');    % store handle
plot(low_quan_MixMF(id1),'LineWidth',2,'Color','b');
plot(upper_quan_MixMF(id1),'LineWidth',2,'Color','b');


