for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_MixN = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);

i=5;
load(['mixCop_Global',num2str(i),'_571_statespace_Z_regression_FF_MF_RealData_Agric.mat']);
for k = 1:length(mix_Mu)
    mix_Precs{k,1} = mix_T{k,1}*mix_T{k,1}';
end
theta_cop1_MixMF = SampleFromMixture_plot(log(mix_Weights),mix_Mu,mix_Precs,nrSamples);


dim_states = 4;
num_states = 571;
id1 = (1:dim_states:dim_states*num_states)';
id2 = (2:dim_states:dim_states*num_states)';
id3 = (3:dim_states:dim_states*num_states)';
id4 = (4:dim_states:dim_states*num_states)';

mean_MCMC = mean(Post.theta,1);
low_quan_MCMC = quantile(Post.theta,0.025);
upper_quan_MCMC = quantile(Post.theta,0.975);

mean_MixN = mean(theta_cop1_MixN,2);
low_quan_MixN = quantile(theta_cop1_MixN,0.025,2);
upper_quan_MixN = quantile(theta_cop1_MixN,0.975,2);

mean_MixMF = mean(theta_cop1_MixMF,2);
